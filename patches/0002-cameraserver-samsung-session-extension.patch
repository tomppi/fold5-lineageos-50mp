+namespace {
+// Samsung's private camera session extension: one method, setParameters, which
+// carries One UI's PDK parameter string to the vendor HAL.
+constexpr const char* kSehSessionDescriptor =
+        "vendor.samsung.hardware.camera.device.ISehCameraDeviceSession";
+constexpr int32_t kSehSetParametersTransaction = 1;
+// Samsung's OutputConfiguration option 2, packed into the stream use case as
+// option << 16; the vendor HAL reads it back as the stream option.
+constexpr int64_t kSamsungHighResStreamUseCase = 0x20000;
+}  // namespace
+
+status_t AidlCamera3Device::AidlHalInterface::sendSamsungSetParameters(const char* params) {
+    if (mAidlSession == nullptr) {
+        return NO_INIT;
+    }
+    if (params == nullptr || params[0] == 0) {
+        return OK;
+    }
+    ndk::SpAIBinder sessionBinder = mAidlSession->asBinder();
+    if (sessionBinder.get() == nullptr) {
+        return NO_INIT;
+    }
+    // Samsung carries ISehCameraDeviceSession as an AIDL binder extension on the
+    // standard session binder; the session binder itself only implements the AOSP
+    // interface, so a transaction addressed to the Samsung interface there is
+    // rejected (FAILED_TRANSACTION).
+    sp<IBinder> platformBinder;
+    AIBinder* extension = nullptr;
+    if (AIBinder_getExtension(sessionBinder.get(), &extension) == STATUS_OK &&
+            extension != nullptr) {
+        platformBinder = AIBinder_toPlatformBinder(extension);
+        AIBinder_decStrong(extension);
+    }
+    if (platformBinder == nullptr) {
+        ALOGW("%s: session has no Samsung extension", __FUNCTION__);
+        return INVALID_OPERATION;
+    }
+    Parcel data, reply;
+    status_t res = data.writeInterfaceToken(String16(kSehSessionDescriptor));
+    if (res != OK) {
+        return res;
+    }
+    res = data.writeString16(String16(params));
+    if (res != OK) {
+        return res;
+    }
+    res = platformBinder->transact(kSehSetParametersTransaction, data, &reply,
+            IBinder::FLAG_PRIVATE_VENDOR);
+    ALOGI("%s: Samsung setParameters -> %d", __FUNCTION__, res);
+    return res;
+}
