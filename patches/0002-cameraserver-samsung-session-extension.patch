+        if (config->streams[i]->use_case == kSamsungHighResStreamUseCase) {
+            samsungHighResRequested = true;
+            break;
+        }
+    }
+    if (samsungHighResRequested) {
+        std::string samsungParams = android::base::GetProperty(
