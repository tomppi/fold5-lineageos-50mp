+namespace {
+
+// Session-parameter tags declared by the camera HAL itself.
+//
+// Samsung's camera HAL publishes its own session key list (shootingMode, ssmShotMode,
+// capturePhysicalId, adaptivePixelMode, ...) under the vendor tag
+// samsung.android.request.availableSessionKeys instead of the AOSP
+// android.request.availableSessionKeys. One UI's cameraserver validates session
+// parameters against that Samsung list; AOSP only validates against the AOSP list,
+// so every Samsung vendor session parameter is silently dropped here and neve
+// reaches the HAL, which then never enters its HighResolution (50 MP) usecase.
+std::vector<int32_t> getVendorSessionKeys(const CameraMetadata& deviceInfo,
+        metadata_vendor_id_t vendorTagId) {
+    static const char* kSamsungSessionKeys = "samsung.android.request.availableSessionKeys";
+
+    sp<VendorTagDescriptorCache> vTagsCache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (vTagsCache == nullptr) {
+        return {};
+    }
+
+    uint32_t vendorTag = 0;
+    bool resolved = false;
+    sp<VendorTagDescriptor> vTags;
+    if (vendorTagId != 0 &&
+            vTagsCache->getVendorTagDescriptor(vendorTagId, &vTags) == NO_ERROR &&
+            vTags != nullptr) {
+        resolved = CameraMetadata::getTagFromName(kSamsungSessionKeys, vTags.get(), &vendorTag) == OK;
+    }
+    if (!resolved) {
+        // The vendor tag id we were handed may not be the one the HAL registered; look
+        // the tag up in every provider's descriptor set before giving up.
+        for (const auto& candidateEntry : vTagsCache->getVendorIdsAndTagDescriptors()) {
+            const sp<VendorTagDescriptor>& candidate = candidateEntry.second;
+            if (candidate != nullptr &&
+                    CameraMetadata::getTagFromName(kSamsungSessionKeys, candidate.get(),
+                            &vendorTag) == OK) {
+                resolved = true;
+                break;
+            }
+        }
+    }
+    if (!resolved) {
+        return {};
+    }
+
+    camera_metadata_ro_entry_t entry = deviceInfo.find(vendorTag);
+    if (entry.count == 0 || entry.data.i32 == nullptr) {
+        return {};
+    }
+    return std::vector<int32_t>(entry.data.i32, entry.data.i32 + entry.count);
+}
